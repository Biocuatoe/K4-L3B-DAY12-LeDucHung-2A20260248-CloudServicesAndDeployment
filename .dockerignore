# ═══════════════════════════════════════════════════════════════════
# CP2 — Files to exclude from Docker build context
#
# Excluding secrets and caches prevents:
#   - .env leaking into the image (API keys, passwords)
#   - .git multiplying the image size
#   - __pycache__/.pytest_cache bloating the image
# ═══════════════════════════════════════════════════════════════════

# Version control
.git
.github

# Virtual environments
.venv
venv
env

# Python caches
__pycache__
*.py[cod]
*.pyc
*.pyo
*.egg-info
*.egg
dist
build

# Test caches
.pytest_cache
.tox
htmlcov
.coverage
.coverage.*

# IDE metadata
.vscode
.idea
*.swp
*.swo

# Environment files (secrets)
.env
.env.local
.env.*.local

# OS artifacts
.DS_Store
Thumbs.db

# Documentation (not needed at runtime)
*.md
!requirements.txt
